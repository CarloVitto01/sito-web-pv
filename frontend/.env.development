# FE locale + BE online: in dev usiamo un base URL relativo cosi' le richieste passano
# dal proxy di vite.config.mts (server.proxy["/api"]) verso il backend di produzione,
# evitando il blocco CORS. Committato (a differenza di .env.development.local) cosi'
# funziona su qualsiasi macchina dopo un git pull, senza setup locale.
REACT_APP_API_BASE_URL=
